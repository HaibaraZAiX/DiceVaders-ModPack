<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DiceVaders.QoL</AssemblyName>
    <RootNamespace>DiceVaders.QoL</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0436;NU1701;MSB3277;CS0618</NoWarn>

    <!-- 发布配置：不嵌入调试信息（否则编译者本机路径会写进 DLL）+ 路径重映射 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\DiceVaders</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <InteropDir>$(BepInExDir)\interop</InteropDir>
    <CoreDir>$(BepInExDir)\core</CoreDir>
    <!-- 共享库：日志出口 + LogOnce 去重日志（v1.1 起 QoL 也接进 ModKit 统一日志） -->
    <ModKitDir>$(MSBuildThisFileDirectory)..\DiceVaders.ModKit\bin\Release</ModKitDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(CoreDir)\BepInEx.Core.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(CoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(CoreDir)\0Harmony.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(CoreDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(CoreDir)\Il2CppInterop.Common.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(InteropDir)\Il2CppSystem.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(InteropDir)\Il2CppSystem.Core.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="ScriptAssembly">
      <HintPath>$(InteropDir)\ScriptAssembly.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(InteropDir)\UnityEngine.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="DiceVaders.ModKit">
      <HintPath>$(ModKitDir)\DiceVaders.ModKit.dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
